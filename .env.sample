DATABASE_NAME=database_name
DATABASE_USER=database_user
DATABASE_PASS=database_password
DATABASE_PORT=5432
DATABASE_HOST=localhost

CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_URL=redis://${CACHE_HOST}:${CACHE_PORT}

PORT=4000

DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASS}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Email/Mail Configuration (Mailgun)
MAIL_USER=your-mailgun-domain@example.com
MAIL_API_KEY=your-mailgun-api-key
MAIL_DOMAIN=your-mailgun-domain.mailgun.org
MAIL_EXPIRES_IN=24h
