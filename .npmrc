# pnpm configuration
shamefully-flatten=false
strict-peer-dependencies=false
auto-install-peers=true

# Node version requirement
engine-strict=true

# Lock Prisma to version 6 LTS (prevent upgrade to v7)
# Use exact versions for Prisma packages
@prisma:registry=https://registry.npmjs.org/
prisma=6.19.0
@prisma/client=6.19.0
