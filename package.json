{
  "name": "be-playground",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "// dev ----------": "----------------------------------------------",
    "dev": "dotenv -e .env.development -- pnpm run start:watch",
    "start:watch": "nodemon --watch src --ext ts --exec \"ts-node --transpile-only src/index.ts\"",
    "setup:dev": "dotenv -e .env.development -- docker compose up -d",
    "db:down": "dotenv -e .env.development -- docker compose down -v",
    "db:logs": "dotenv -e .env.development -- docker compose logs -f database redis",
    "// build/prod ----": "----------------------------------------------",
    "build": "pnpm run tsc",
    "tsc": "tsc -p .",
    "start": "dotenv -e .env.production -- node dist/index.js",
    "start:prod": "pnpm run start",
    "// prisma --------": "----------------------------------------------",
    "prisma:generate": "pnpm prisma generate",
    "prisma:validate": "dotenv -e .env.development -- pnpm prisma validate",
    "migrate:dev": "dotenv -e .env.development -- pnpm prisma migrate dev --schema ./prisma/schema.prisma",
    "migrate:deploy:prod": "dotenv -e .env.production -- pnpm prisma migrate deploy --schema ./prisma/schema.prisma",
    "migrate:deploy:dev": "dotenv -e .env.development -- pnpm prisma migrate deploy --schema ./prisma/schema.prisma",
    "studio:dev": "dotenv -e .env.development -- pnpm prisma studio",
    "studio:prod": "dotenv -e .env.production -- pnpm prisma studio",
    "seed:dev": "dotenv -e .env.development -- ts-node ./prisma/seeder/seeder.ts",
    "seed:prod": "dotenv -e .env.production -- ts-node ./prisma/seeder/seeder.ts",
    "seed:prod:compiled": "dotenv -e .env.production -- node ./dist/seeder/seeder.js",
    "migrate:reset:dev": "dotenv -e .env.development -- pnpm prisma migrate reset --force --schema ./prisma/schema.prisma",
    "migrate:reset:prod": "dotenv -e .env.production -- pnpm prisma migrate reset --force --schema ./prisma/schema.prisma",
    "migrate:create:dev": "dotenv -e .env.development -- pnpm prisma migrate dev --create-only --schema ./prisma/schema.prisma",
    "// quality -------": "----------------------------------------------",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"{src,apps,libs,test,prisma}/**/*.{ts,tsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@prisma/client": "7",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-helpers": "^2.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unicorn": "^62.0.0",
    "nodemon": "^3.1.11",
    "prettier": "3.7.4",
    "prisma": "7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/nodemailer-mailgun-transport": "^1.4.6",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.1",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cors": "^2.8.5",
    "csvtojson": "^2.0.14",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.11",
    "nodemailer-mailgun-transport": "^2.1.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  }
}
